  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Mission:\n\u25BA \"Grab\" the red DNA model and hold it for three seconds.
    Then you will see the DNA condensed as a chromosome shape.\n\u25BA Then, if you
    \"touch\" the centriole and drag it to the red chromosome. You will see the spindle
    fiber (purple line) comes from the centriole and is connected to the chromosome."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_fontSharedMaterials: []
  m_fontMaterial: {fileID: 0}
